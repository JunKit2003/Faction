# Database: "mysql" or "pg"
DB_CLIENT=pg
# mysql://user:pass@host:3306/faction   or   postgres://user:pass@host:5432/faction
DATABASE_URL=postgres://faction:faction@localhost:54321/faction
# HTTP port the Node process listens on
PORT=3000
# Public URL of the site (used for canonical links, sitemap, Origin checks)
PUBLIC_BASE_URL=http://localhost:3000
# Folder for uploaded images. MUST persist between deploys.
UPLOAD_DIR=./uploads
# Optional: create this admin on first start if there are no admins yet
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Admin
NODE_ENV=development

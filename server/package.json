{
  "name": "@faction/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:pg": "TEST_DB_CLIENT=pg TEST_DATABASE_URL=postgres://faction:faction@localhost:54321/faction vitest run",
    "test:mysql": "TEST_DB_CLIENT=mysql TEST_DATABASE_URL=mysql://root:faction-root@localhost:33061/faction vitest run",
    "db:migrate": "tsx --env-file-if-exists=../.env src/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../.env src/cli/seed.ts",
    "admin:create": "tsx --env-file-if-exists=../.env src/cli/admin.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "kysely": "^0.29.9",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "@faction/shared": "*"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
